<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <center>
      <ScrollPane fitToWidth="true">
         <content>
            <VBox spacing="25.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <!-- Header -->
                  <Label text="Profile &amp; Settings" styleClass="page-title">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
                  
                  <!-- Personal Information Section -->
                  <VBox spacing="15.0" styleClass="profile-section">
                     <children>
                        <Label text="Personal Information" styleClass="section-title">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Label>
                        
                        <GridPane hgap="15.0" vgap="15.0" maxWidth="600.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="NEVER" minWidth="120.0" />
                              <ColumnConstraints hgrow="ALWAYS" />
                           </columnConstraints>
                           <children>
                              <Label text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                              <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                              
                              <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                              <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                              
                              <Label text="Age:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                              <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                 <children>
                                    <TextField fx:id="ageField" prefWidth="100.0" />
                                    <Label text="years" />
                                 </children>
                              </HBox>
                              
                              <Label text="Gender:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                              <ComboBox fx:id="genderCombo" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                              
                              <Label text="Height:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                              <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                 <children>
                                    <TextField fx:id="heightField" prefWidth="100.0" />
                                    <Label text="cm" />
                                 </children>
                              </HBox>
                              
                              <Label text="Current Weight:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                              <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                                 <children>
                                    <TextField fx:id="weightField" prefWidth="100.0" />
                                    <Label text="kg" />
                                 </children>
                              </HBox>
                              
                              <Label text="Activity Level:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                              <ComboBox fx:id="activityLevelCombo" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                           </children>
                        </GridPane>
                        
                        <HBox spacing="15.0">
                           <children>
                              <Button fx:id="saveProfileBtn" text="Save Profile" onAction="#saveProfile" styleClass="primary-button" />
                              <Button fx:id="calculateStatsBtn" text="Recalculate Stats" onAction="#calculateStats" />
                           </children>
                        </HBox>
                        
                        <!-- Calculated Stats Display -->
                        <VBox spacing="8.0">
                           <children>
                              <Label text="Calculated Statistics:" styleClass="subsection-title">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Label>
                              <GridPane hgap="20.0" vgap="8.0">
                                 <columnConstraints>
                                    <ColumnConstraints hgrow="NEVER" minWidth="80.0" />
                                    <ColumnConstraints hgrow="NEVER" minWidth="150.0" />
                                    <ColumnConstraints hgrow="NEVER" minWidth="80.0" />
                                    <ColumnConstraints hgrow="ALWAYS" />
                                 </columnConstraints>
                                 <children>
                                    <Label text="BMI:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <Label fx:id="bmiValueLabel" text="26.1" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                    <Label text="BMR:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                    <Label fx:id="bmrValueLabel" text="1,650 cal/day" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                                    
                                    <Label text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                    <Label fx:id="bmiCategoryLabel" text="Overweight" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <Label text="TDEE:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                    <Label fx:id="tdeeValueLabel" text="2,200 cal/day" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                                 </children>
                              </GridPane>
                           </children>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
                  
                  <!-- Device Integration Section -->
                  <VBox spacing="15.0" styleClass="profile-section">
                     <children>
                        <Label text="Device Integrations" styleClass="section-title">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Label>
                        
                        <VBox spacing="12.0">
                           <children>
                              <!-- Fitbit -->
                              <HBox spacing="15.0">
                                 <children>
                                    <Label text="Fitbit:" prefWidth="100.0" />
                                    <Button fx:id="connectFitbitBtn" text="Connect" onAction="#connectFitbit" />
                                    <Label fx:id="fitbitStatusLabel" text="Not Connected" styleClass="status-disconnected" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="disconnectFitbitBtn" text="Disconnect" onAction="#disconnectFitbit" disable="true" />
                                 </children>
                              </HBox>
                              
                              <!-- Apple Health -->
                              <HBox spacing="15.0">
                                 <children>
                                    <Label text="Apple Health:" prefWidth="100.0" />
                                    <Button fx:id="connectAppleBtn" text="Connect" onAction="#connectAppleHealth" />
                                    <Label fx:id="appleStatusLabel" text="Not Connected" styleClass="status-disconnected" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="disconnectAppleBtn" text="Disconnect" onAction="#disconnectAppleHealth" disable="true" />
                                 </children>
                              </HBox>
                              
                              <!-- Google Fit -->
                              <HBox spacing="15.0">
                                 <children>
                                    <Label text="Google Fit:" prefWidth="100.0" />
                                    <Button fx:id="connectGoogleBtn" text="Connect" onAction="#connectGoogleFit" />
                                    <Label fx:id="googleStatusLabel" text="Connected" styleClass="status-connected" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="disconnectGoogleBtn" text="Disconnect" onAction="#disconnectGoogleFit" />
                                 </children>
                              </HBox>
                              
                              <!-- MyFitnessPal -->
                              <HBox spacing="15.0">
                                 <children>
                                    <Label text="MyFitnessPal:" prefWidth="100.0" />
                                    <Button fx:id="connectMFPBtn" text="Connect" onAction="#connectMyFitnessPal" />
                                    <Label fx:id="mfpStatusLabel" text="Not Connected" styleClass="status-disconnected" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="disconnectMFPBtn" text="Disconnect" onAction="#disconnectMyFitnessPal" disable="true" />
                                 </children>
                              </HBox>
                              
                              <!-- Strava -->
                              <HBox spacing="15.0">
                                 <children>
                                    <Label text="Strava:" prefWidth="100.0" />
                                    <Button fx:id="connectStravaBtn" text="Connect" onAction="#connectStrava" />
                                    <Label fx:id="stravaStatusLabel" text="Not Connected" styleClass="status-disconnected" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="disconnectStravaBtn" text="Disconnect" onAction="#disconnectStrava" disable="true" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        
                        <HBox spacing="15.0">
                           <children>
                              <Button fx:id="syncAllBtn" text="Sync All Connected Devices" onAction="#syncAllDevices" />
                              <Label fx:id="lastSyncLabel" text="Last sync: 2 hours ago" styleClass="stat-detail" />
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
                  
                  <!-- App Settings Section -->
                  <VBox spacing="15.0" styleClass="profile-section">
                     <children>
                        <Label text="App Settings" styleClass="section-title">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Label>
                        
                        <VBox spacing="12.0">
                           <children>
                              <HBox spacing="15.0">
                                 <children>
                                    <Label text="Theme:" prefWidth="120.0" />
                                    <ComboBox fx:id="themeCombo" prefWidth="150.0" />
                                 </children>
                              </HBox>
                              
                              <HBox spacing="15.0">
                                 <children>
                                    <Label text="Units:" prefWidth="120.0" />
                                    <ComboBox fx:id="unitsCombo" prefWidth="150.0" />
                                 </children>
                              </HBox>
                              
                              <HBox spacing="15.0">
                                 <children>
                                    <Label text="Language:" prefWidth="120.0" />
                                    <ComboBox fx:id="languageCombo" prefWidth="150.0" />
                                 </children>
                              </HBox>
                              
                              <HBox spacing="15.0">
                                 <children>
                                    <Label text="Start Page:" prefWidth="120.0" />
                                    <ComboBox fx:id="startPageCombo" prefWidth="150.0" />
                                 </children>
                              </HBox>
                              
                              <VBox spacing="8.0">
                                 <children>
                                    <CheckBox fx:id="autoSyncCheck" text="Auto-sync with connected devices" />
                                    <CheckBox fx:id="offlineModeCheck" text="Enable offline mode" />
                                    <CheckBox fx:id="analyticsCheck" text="Help improve the app by sharing anonymous usage data" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
                  
                  <!-- Privacy & Data Section -->
                  <VBox spacing="15.0" styleClass="profile-section">
                     <children>
                        <Label text="Privacy &amp; Data" styleClass="section-title">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Label>
                        
                        <VBox spacing="12.0">
                           <children>
                              <HBox spacing="15.0">
                                 <children>
                                    <Button fx:id="exportDataBtn" text="Export My Data" onAction="#exportData" />
                                    <Label text="Download all your data in CSV format" styleClass="help-text" />
                                 </children>
                              </HBox>
                              
                              <HBox spacing="15.0">
                                 <children>
                                    <Button fx:id="importDataBtn" text="Import Data" onAction="#importData" />
                                    <Label text="Import data from other apps or backups" styleClass="help-text" />
                                 </children>
                              </HBox>
                              
                              <HBox spacing="15.0">
                                 <children>
                                    <Button fx:id="backupDataBtn" text="Backup Data" onAction="#backupData" />
                                    <Label text="Create a backup of all your data" styleClass="help-text" />
                                 </children>
                              </HBox>
                              
                              <Separator />
                              
                              <HBox spacing="15.0">
                                 <children>
                                    <Button fx:id="clearCacheBtn" text="Clear Cache" onAction="#clearCache" />
                                    <Label text="Free up storage space" styleClass="help-text" />
                                 </children>
                              </HBox>
                              
                              <HBox spacing="15.0">
                                 <children>
                                    <Button fx:id="resetAppBtn" text="Reset All Data" onAction="#resetApp" styleClass="danger-button" />
                                    <Label text="⚠️ This will delete all your data permanently!" styleClass="warning-text" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
                  
                  <!-- About Section -->
                  <VBox spacing="15.0" styleClass="profile-section">
                     <children>
                        <Label text="About" styleClass="section-title">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Label>
                        
                        <VBox spacing="8.0">
                           <children>
                              <Label text="Calorie Tracker Pro v1.0.0" styleClass="app-version" />
                              <Label text="Built with Scala and JavaFX" styleClass="help-text" />
                              
                              <HBox spacing="15.0">
                                 <children>
                                    <Button fx:id="aboutBtn" text="About" onAction="#showAbout" />
                                    <Button fx:id="privacyPolicyBtn" text="Privacy Policy" onAction="#showPrivacyPolicy" />
                                    <Button fx:id="termsBtn" text="Terms of Service" onAction="#showTerms" />
                                    <Button fx:id="supportBtn" text="Support" onAction="#showSupport" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
