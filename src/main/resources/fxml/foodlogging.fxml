<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <center>
      <VBox spacing="15.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <!-- Header -->
            <Label text="Food Logging" styleClass="page-title">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            
            <!-- Food Search Section -->
            <VBox spacing="10.0">
               <children>
                  <Label text="Add Food" styleClass="section-title">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <HBox spacing="10.0">
                     <children>
                        <TextField fx:id="searchField" promptText="Search for food..." prefWidth="300.0" />
                        <Button fx:id="searchButton" text="Search" onAction="#searchFood" />
                        <Button fx:id="barcodeButton" text="📷 Scan Barcode" onAction="#scanBarcode" />
                        <Button fx:id="arButton" text="🔍 AR Scanner" onAction="#scanWithAR" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <!-- Food Results and Manual Entry -->
            <HBox spacing="20.0">
               <children>
                  <!-- Left Side - Food Database -->
                  <VBox prefWidth="400.0" spacing="10.0">
                     <children>
                        <Label text="Food Database" styleClass="section-title">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                        <TableView fx:id="foodTable" prefHeight="300.0">
                           <columns>
                              <TableColumn fx:id="nameColumn" text="Food" prefWidth="150.0" />
                              <TableColumn fx:id="calorieColumn" text="Calories" prefWidth="80.0" />
                              <TableColumn fx:id="proteinColumn" text="Protein" prefWidth="80.0" />
                              <TableColumn fx:id="fatColumn" text="Fat" prefWidth="60.0" />
                              <TableColumn fx:id="carbColumn" text="Carbs" prefWidth="70.0" />
                           </columns>
                        </TableView>
                        
                        <HBox spacing="10.0">
                           <children>
                              <Label text="Serving size:" />
                              <Spinner fx:id="servingSpinner" initialValue="1.0" min="0.1" max="10.0" editable="true" prefWidth="100.0" />
                              <ComboBox fx:id="mealTypeCombo" prefWidth="120.0" />
                              <Button fx:id="addFoodButton" text="Add to Meal" onAction="#addSelectedFood" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  
                  <!-- Right Side - Manual Entry -->
                  <VBox prefWidth="300.0" spacing="10.0">
                     <children>
                        <Label text="Manual Food Entry" styleClass="section-title">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                        <GridPane hgap="10.0" vgap="10.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="NEVER" minWidth="80.0" />
                              <ColumnConstraints hgrow="ALWAYS" />
                           </columnConstraints>
                           <children>
                              <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                              <TextField fx:id="manualNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                              
                              <Label text="Calories:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                              <TextField fx:id="manualCaloriesField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                              
                              <Label text="Protein (g):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                              <TextField fx:id="manualProteinField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                              
                              <Label text="Fat (g):" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                              <TextField fx:id="manualFatField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                              
                              <Label text="Carbs (g):" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                              <TextField fx:id="manualCarbsField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                              
                              <Label text="Meal:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                              <ComboBox fx:id="manualMealCombo" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                           </children>
                        </GridPane>
                        <Button fx:id="addManualButton" text="Add Manual Entry" onAction="#addManualFood" maxWidth="200.0" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            
            <!-- Today's Meals -->
            <VBox spacing="10.0">
               <children>
                  <Label text="Today's Meals" styleClass="section-title">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  
                  <!-- Meal Tabs -->
                  <TabPane fx:id="mealTabs" prefHeight="250.0">
                     <tabs>
                        <Tab text="Breakfast" fx:id="breakfastTab">
                           <content>
                              <VBox spacing="10.0">
                                 <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </padding>
                                 <children>
                                    <ListView fx:id="breakfastList" prefHeight="150.0" />
                                    <HBox>
                                       <children>
                                          <Label fx:id="breakfastStats" text="Calories: 0 | Protein: 0g | Fat: 0g | Carbs: 0g" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Button fx:id="clearBreakfastBtn" text="Clear" onAction="#clearBreakfast" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </content>
                        </Tab>
                        
                        <Tab text="Lunch" fx:id="lunchTab">
                           <content>
                              <VBox spacing="10.0">
                                 <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </padding>
                                 <children>
                                    <ListView fx:id="lunchList" prefHeight="150.0" />
                                    <HBox>
                                       <children>
                                          <Label fx:id="lunchStats" text="Calories: 0 | Protein: 0g | Fat: 0g | Carbs: 0g" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Button fx:id="clearLunchBtn" text="Clear" onAction="#clearLunch" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </content>
                        </Tab>
                        
                        <Tab text="Dinner" fx:id="dinnerTab">
                           <content>
                              <VBox spacing="10.0">
                                 <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </padding>
                                 <children>
                                    <ListView fx:id="dinnerList" prefHeight="150.0" />
                                    <HBox>
                                       <children>
                                          <Label fx:id="dinnerStats" text="Calories: 0 | Protein: 0g | Fat: 0g | Carbs: 0g" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Button fx:id="clearDinnerBtn" text="Clear" onAction="#clearDinner" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </content>
                        </Tab>
                        
                        <Tab text="Snacks" fx:id="snacksTab">
                           <content>
                              <VBox spacing="10.0">
                                 <padding>
                                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                 </padding>
                                 <children>
                                    <ListView fx:id="snacksList" prefHeight="150.0" />
                                    <HBox>
                                       <children>
                                          <Label fx:id="snacksStats" text="Calories: 0 | Protein: 0g | Fat: 0g | Carbs: 0g" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Button fx:id="clearSnacksBtn" text="Clear" onAction="#clearSnacks" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </content>
                        </Tab>
                     </tabs>
                  </TabPane>
                  
                  <!-- Daily Total -->
                  <HBox>
                     <children>
                        <Label fx:id="dailyTotalLabel" text="Daily Total: Calories: 0 | Protein: 0g | Fat: 0g | Carbs: 0g" 
                               styleClass="total-stats">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <!-- Recently Added -->
            <VBox spacing="10.0">
               <children>
                  <Label text="Recently Added Foods" styleClass="section-title">
                     <font>
                        <Font size="16.0" />
                     </font>
                  </Label>
                  <ListView fx:id="recentFoodsList" prefHeight="100.0" />
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
