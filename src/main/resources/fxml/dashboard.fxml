<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <center>
      <ScrollPane fitToWidth="true">
         <content>
            <VBox spacing="20.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <!-- Header -->
                  <VBox>
                     <children>
                        <Label fx:id="welcomeLabel" text="Welcome back!" styleClass="header-label">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Label>
                        <Label fx:id="dateLabel" text="Today - August 18, 2025" styleClass="subtitle">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  
                  <!-- Quick Stats Row -->
                  <HBox spacing="20.0">
                     <children>
                        <!-- Calorie Card -->
                        <VBox fx:id="calorieCard" styleClass="stat-card" prefWidth="250.0">
                           <children>
                              <Label text="Calories" styleClass="card-title" />
                              <Label fx:id="calorieLabel" text="1,850 / 2,200" styleClass="stat-value" />
                              <ProgressBar fx:id="calorieProgress" progress="0.84" prefWidth="200.0" />
                              <Label fx:id="calorieRemaining" text="350 remaining" styleClass="stat-detail" />
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                        
                        <!-- Exercise Card -->
                        <VBox fx:id="exerciseCard" styleClass="stat-card" prefWidth="250.0">
                           <children>
                              <Label text="Exercise" styleClass="card-title" />
                              <Label fx:id="exerciseLabel" text="450 cal burned" styleClass="stat-value" />
                              <Label fx:id="exerciseTime" text="45 minutes" styleClass="stat-detail" />
                              <Label fx:id="stepsLabel" text="8,542 steps" styleClass="stat-detail" />
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                        
                        <!-- Water Card -->
                        <VBox fx:id="waterCard" styleClass="stat-card" prefWidth="200.0">
                           <children>
                              <Label text="Water" styleClass="card-title" />
                              <Label fx:id="waterLabel" text="2.1 / 2.5 L" styleClass="stat-value" />
                              <ProgressBar fx:id="waterProgress" progress="0.84" prefWidth="150.0" />
                              <Button fx:id="addWaterBtn" text="Add 250ml" onAction="#addWater" />
                           </children>
                           <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                           </padding>
                        </VBox>
                     </children>
                  </HBox>
                  
                  <!-- Charts Row -->
                  <HBox spacing="20.0">
                     <children>
                        <!-- Macro Breakdown Pie Chart -->
                        <VBox prefWidth="400.0">
                           <children>
                              <Label text="Today's Macros" styleClass="section-title">
                                 <font>
                                    <Font size="18.0" />
                                 </font>
                              </Label>
                              <PieChart fx:id="macroChart" prefHeight="300.0" />
                           </children>
                        </VBox>
                        
                        <!-- Weekly Calorie Trend -->
                        <VBox prefWidth="500.0">
                           <children>
                              <Label text="Weekly Calorie Intake" styleClass="section-title">
                                 <font>
                                    <Font size="18.0" />
                                 </font>
                              </Label>
                              <LineChart fx:id="weeklyChart" prefHeight="300.0">
                                 <xAxis>
                                    <CategoryAxis fx:id="weeklyXAxis" />
                                 </xAxis>
                                 <yAxis>
                                    <NumberAxis fx:id="weeklyYAxis" />
                                 </yAxis>
                              </LineChart>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  
                  <!-- Quick Actions -->
                  <VBox>
                     <children>
                        <Label text="Quick Actions" styleClass="section-title">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Label>
                        <HBox spacing="15.0">
                           <children>
                              <Button fx:id="quickAddFoodBtn" text="Add Food" onAction="#quickAddFood" prefWidth="120.0" />
                              <Button fx:id="quickAddExerciseBtn" text="Add Exercise" onAction="#quickAddExercise" prefWidth="120.0" />
                              <Button fx:id="logWeightBtn" text="Log Weight" onAction="#logWeight" prefWidth="120.0" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  
                  <!-- Motivation Section -->
                  <VBox>
                     <children>
                        <Label text="Today's Motivation" styleClass="section-title">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                        <Label fx:id="motivationLabel" text="Great progress today! You're 84% towards your calorie goal." 
                               wrapText="true" styleClass="motivation-text" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
