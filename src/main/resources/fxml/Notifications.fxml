<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.SpinnerValueFactory?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.NotificationsController" prefWidth="900" prefHeight="620">
    <top>
        <HBox fx:id="navBar" spacing="8" alignment="CENTER_LEFT" styleClass="top-bar">
            <Button text="Home" fx:id="homeBtn" styleClass="nav-btn"/>
            <Button text="Food Logging" fx:id="foodLoggingBtn" styleClass="nav-btn"/>
            <Button text="Activity" fx:id="activityBtn" styleClass="nav-btn"/>
            <Button text="Goals" fx:id="goalsBtn" styleClass="nav-btn"/>
            <Button text="Progress" fx:id="progressBtn" styleClass="nav-btn"/>
            <Button text="Notifications" fx:id="notificationsBtn" styleClass="nav-btn selected"/>
            <Button text="Profile" fx:id="profileBtn" styleClass="nav-btn"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="22" styleClass="content-container">
            <VBox spacing="10" styleClass="card">
                <Label text="Meal Reminders" styleClass="section-header"/>
                <FlowPane hgap="16" vgap="8">
                    <CheckBox fx:id="breakfastReminder" text="Breakfast"/>
                    <CheckBox fx:id="lunchReminder" text="Lunch"/>
                    <CheckBox fx:id="dinnerReminder" text="Dinner"/>
                    <CheckBox fx:id="snacksReminder" text="Snacks"/>
                </FlowPane>
            </VBox>
            <VBox spacing="10" styleClass="card">
                <Label text="Goal Alerts" styleClass="section-header"/>
                <CheckBox fx:id="goalAlert" text="Calorie Goal Reached"/>
            </VBox>
            <VBox spacing="10" styleClass="card">
                <Label text="Custom Reminder Hour (0-23)" styleClass="section-header"/>
                <Spinner fx:id="reminderTimeSpinner" prefWidth="120">
                    <valueFactory>
                        <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="23" initialValue="8"/>
                    </valueFactory>
                </Spinner>
                <Button text="Save" fx:id="saveNotificationsBtn" styleClass="primary-btn pill-btn"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
