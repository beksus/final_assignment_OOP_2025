<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.GoalsController" prefWidth="1100" prefHeight="720">
    <top>
        <HBox fx:id="navBar" spacing="8" alignment="CENTER_LEFT" styleClass="top-bar">
            <Button text="Home" fx:id="homeBtn" styleClass="nav-btn"/>
            <Button text="Food Logging" fx:id="foodLoggingBtn" styleClass="nav-btn"/>
            <Button text="Activity" fx:id="activityBtn" styleClass="nav-btn"/>
            <Button text="Goals" fx:id="goalsBtn" styleClass="nav-btn selected"/>
            <Button text="Progress" fx:id="progressBtn" styleClass="nav-btn"/>
            <Button text="Notifications" fx:id="notificationsBtn" styleClass="nav-btn"/>
            <Button text="Profile" fx:id="profileBtn" styleClass="nav-btn"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="24" styleClass="content-container">
            <HBox spacing="24">
                <VBox spacing="16" styleClass="card">
                    <Label text="Weight Goal" styleClass="section-header"/>
                    <ChoiceBox fx:id="weightGoalChoice" prefWidth="240"/>
                    <Label text="Calorie Target" styleClass="section-sub"/>
                    <TextField fx:id="calorieTargetField" promptText="Target Calories"/>
                    <Label text="Water Intake Goal (L)" styleClass="section-sub"/>
                    <TextField fx:id="waterGoalField" promptText="Liters"/>
                    <Button text="Save" fx:id="saveGoalsBtn" styleClass="primary-btn pill-btn"/>
                </VBox>
                <VBox spacing="16" styleClass="card wide-card">
                    <Label text="Macro Split (%)" styleClass="section-header"/>
                    <GridPane hgap="10" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="80"/>
                        </columnConstraints>
                        <children>
                            <Label text="Carbs"/>
                            <Slider fx:id="carbsSlider" min="0" max="100" value="50" GridPane.columnIndex="1"/>
                            <Label text="Protein" GridPane.rowIndex="1"/>
                            <Slider fx:id="proteinSlider" min="0" max="100" value="30" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Label text="Fat" GridPane.rowIndex="2"/>
                            <Slider fx:id="fatSlider" min="0" max="100" value="20" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        </children>
                    </GridPane>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
